##########################################################################
## Poisson-Binomial single-year model by Stewart and Weller
##########################################################################
##
## Each year is treated independently without any sharing of information.
## Observed counts per shift is a Binomial deviate with the weekly mean
## coming from a Poisson distribution. 
##
## It worked fine until the number of counts decreased and they were spread
## across several weeks. This problem is explained in Eguchi et al. (2026)
##
## This model was written by Josh Stewart


    model {
      p.obs ~ dnorm(0.889,0.06375^-2) #estimated observation probability
      
      for(j in 1:n.weeks){
        lambda[j] ~ dunif(0,40)
      }

      for(i in 1:n.obs){
        count.true[i] ~ dpois(lambda[week[i]])      
        p.obs.corr[i] <- p.obs * effort[i]/3 # watch period is 3 hours, so any amount of effort below 3 hours scales the observation probability accordingly
        
        count.obs[i] ~ dbin(p.obs.corr[i], count.true[i])
        loglik[i] <- logdensity.bin(count.obs[i], p.obs.corr[i], count.true[i])
      }#i

    Total.Calves <- sum(count.true[1:n.obs])

    }#model
    
